generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRoleEnum {
  super_admin
  ticket_manager
  developer
  client
}

model Users {
  id         String      @id @default(uuid())
  firstName  String
  lastName   String
  email      String      @unique
  password   String?
  provider   String?
  providerId String?
  userRoles  UserRoles[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  Clients    Clients[]
}

model Roles {
  id        String       @id @default(uuid())
  name      UserRoleEnum @unique
  userRoles UserRoles[]
}

model UserRoles {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Roles    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

enum ProductStatus {
  active
  inactive
}

enum SupportTier {
  premium
  standard
}

enum ClientStatus {
  active
  inactive
}

model Products {
  id          String        @id @default(uuid())
  productCode String        @unique
  name        String
  description String?
  status      ProductStatus @default(active)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  clientProducts ClientProduct[]

  @@map("Products")
}

model Clients {
  id          String       @id @default(uuid())
  clientCode  String       @unique
  companyName String
  supportTier SupportTier  @default(standard)
  status      ClientStatus @default(active)
  createdBy   String       @default(uuid())
  userId      String       @default(uuid())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        Users?       @relation(fields: [userId], references: [id])
  clientProducts ClientProduct[]

  @@map("Clients")
}

model ClientProduct {
  id        String   @id @default(uuid())
  clientId  String
  productId String
  client    Clients  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product   Products @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([clientId, productId])
  @@map("ClientProduct")
}
